{
  "entities": {
    "Board": {
      "title": "Board",
      "description": "A task document/project board containing tasks",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the board or project",
          "maxLength": 100,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description of the board",
          "maxLength": 500
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier for the board",
          "maxLength": 50
        },
        "color": {
          "type": "string",
          "description": "Accent color for the board",
          "maxLength": 20
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the owner who created the board",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "id": {
          "type": "string",
          "description": "Document ID of the board",
          "maxLength": 128
        },
        "isCloud": {
          "type": "boolean",
          "description": "Whether board is synced with cloud"
        }
      },
      "required": ["title", "ownerId"]
    },
    "Task": {
      "title": "Task",
      "description": "A task item in a board column",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the task",
          "maxLength": 150,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of what needs to be done",
          "maxLength": 3000
        },
        "status": {
          "type": "string",
          "description": "Column status: todo, in_progress, done",
          "enum": ["todo", "in_progress", "done"]
        },
        "priority": {
          "type": "string",
          "description": "Priority level",
          "enum": ["low", "medium", "high", "urgent"]
        },
        "category": {
          "type": "string",
          "description": "Category name for custom categorization",
          "maxLength": 50
        },
        "tags": {
          "type": "array",
          "description": "Custom tags for the task"
        },
        "subtasks": {
          "type": "array",
          "description": "Checklist of subtasks"
        },
        "screenshotUrl": {
          "type": "string",
          "description": "Optional screenshot or illustration image data/url",
          "maxLength": 500000
        },
        "order": {
          "type": "number",
          "description": "Ordering within the column"
        },
        "boardId": {
          "type": "string",
          "description": "Parent board ID",
          "maxLength": 128
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the task creator",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "id": {
          "type": "string",
          "description": "Document ID of the task",
          "maxLength": 128
        }
      },
      "required": ["title", "status", "boardId", "ownerId"]
    }
  },
  "firestore": {
    "/boards/{boardId}": {
      "schema": {
        "$ref": "#/entities/Board"
      },
      "description": "User project boards / task documents"
    },
    "/boards/{boardId}/tasks/{taskId}": {
      "schema": {
        "$ref": "#/entities/Task"
      },
      "description": "Tasks belonging to a specific board"
    }
  }
}
