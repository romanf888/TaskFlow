rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBoard(data) {
      return data.keys().hasAll(['title', 'ownerId']) &&
        data.keys().hasOnly(['title', 'ownerId', 'description', 'icon', 'color', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.ownerId is string && data.ownerId == request.auth.uid &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 20));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'status', 'boardId', 'ownerId']) &&
        data.keys().hasOnly(['title', 'status', 'boardId', 'ownerId', 'description', 'priority', 'category', 'tags', 'subtasks', 'screenshotUrl', 'order', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.status in ['todo', 'in_progress', 'done'] &&
        data.boardId is string && data.boardId.size() <= 128 &&
        data.ownerId is string && data.ownerId == request.auth.uid &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        (!('priority' in data) || data.priority in ['low', 'medium', 'high', 'urgent']) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 15)) &&
        (!('subtasks' in data) || (data.subtasks is list && data.subtasks.size() <= 50)) &&
        (!('screenshotUrl' in data) || (data.screenshotUrl is string && data.screenshotUrl.size() <= 500000)) &&
        (!('order' in data) || data.order is number);
    }

    // Boards collection
    match /boards/{boardId} {
      allow get: if isSignedIn() && isValidId(boardId) && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(boardId) && isValidBoard(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(boardId) && isValidBoard(incoming()) && existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isValidId(boardId) && existing().ownerId == request.auth.uid;

      // Tasks subcollection under a board
      match /tasks/{taskId} {
        allow get: if isSignedIn() && isValidId(taskId) && resource.data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().boardId == boardId &&
          get(/databases/$(database)/documents/boards/$(boardId)).data.ownerId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().boardId == existing().boardId;
        allow delete: if isSignedIn() && isValidId(taskId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
